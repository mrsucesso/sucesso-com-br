---
const title = 'Raio-X do Sucesso | Sucesso Empresarial';
const description = 'Responda 10 perguntas e receba um mapa prático de oportunidades para o seu negócio.';
const apiBase = import.meta.env.PUBLIC_RAIO_X_API_BASE || 'http://127.0.0.1:3811';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071829" />
    <link rel="canonical" href="https://sucesso.com.br/raio-x" />
    <link rel="icon" type="image/jpeg" sizes="512x512" href="/images/favicon-sucesso-empresarial.jpg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    {turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand" aria-label="Sucesso Empresarial">
        <span class="brand-mark"><img src="/images/logo-sucesso-flat-branca.png" alt="" /></span>
        <span>Sucesso <b>Empresarial</b></span>
      </a>
      <a class="header-link" href="/resultado21/">Resultado 21</a>
    </header>

    <main class="shell" data-state="intro">
      <section class="intro" id="intro" data-panel-state="intro" aria-labelledby="page-title" aria-hidden="false">
        <p class="kicker">RAIO-X DO SUCESSO</p>
        <h1 id="page-title">Encontre onde existe dinheiro mais perto no seu negócio.</h1>
        <p class="lead">Responda 10 perguntas objetivas. No fim, você verá três oportunidades práticas, uma ação para os próximos 7 dias e caminhos para continuar.</p>
        <div class="trust-row"><span>10 perguntas</span><span>Leva cerca de 4 minutos</span></div>
        <button class="button button-primary button-large" id="start-button" type="button">Começar o Raio-X <span aria-hidden="true">→</span></button>
      </section>

      <section class="form-panel" id="form-panel" data-panel-state="form" hidden aria-hidden="true" aria-labelledby="form-title">
        <div class="progress-head">
          <p class="kicker" id="form-title">SEU CONTEXTO</p>
          <p class="progress-text" aria-live="polite">Pergunta <span id="progress-current">1</span> de 10</p>
        </div>
        <div class="progress-track" aria-hidden="true"><span id="progress-bar"></span></div>
        <p class="status-message" id="form-status" role="status" aria-live="polite"></p>

        <form id="diagnosis-form" novalidate>
          <div class="question" data-step="0">
            <label for="name">Como podemos chamar você?</label>
            <p class="hint">Use seu primeiro nome ou como prefere ser chamado.</p>
            <input id="name" name="name" type="text" autocomplete="given-name" minlength="2" maxlength="120" required />
          </div>
          <div class="question" data-step="1" hidden>
            <fieldset><legend>Qual é sua relação com o negócio?</legend>
              <div class="choice-grid"><label class="choice"><input type="radio" name="role" value="owner" required /><span>Sou dono ou sócio</span></label><label class="choice"><input type="radio" name="role" value="manager" /><span>Gerencio a operação</span></label><label class="choice"><input type="radio" name="role" value="professional" /><span>Sou profissional da empresa</span></label><label class="choice"><input type="radio" name="role" value="sales" /><span>Atuo em vendas</span></label><label class="choice"><input type="radio" name="role" value="other" /><span>Outra relação</span></label></div>
            </fieldset>
          </div>
          <div class="question" data-step="2" hidden>
            <label for="main_offer">Em uma frase, o que sua empresa vende?</label>
            <p class="hint">Pode ser um produto, serviço ou tipo de projeto.</p>
            <textarea id="main_offer" name="main_offer" rows="4" minlength="3" maxlength="500" required></textarea>
          </div>
          <div class="question" data-step="3" hidden>
            <fieldset><legend>Como os clientes normalmente compram?</legend><p class="question-instruction">Escolha a opção que melhor representa o comportamento predominante.</p>
              <div class="choice-grid"><label class="choice"><input type="radio" name="purchase_mode" value="appointment" required /><span>Agendam um horário</span></label><label class="choice"><input type="radio" name="purchase_mode" value="quote" /><span>Pedem um orçamento</span></label><label class="choice"><input type="radio" name="purchase_mode" value="direct" /><span>Compram diretamente</span></label><label class="choice"><input type="radio" name="purchase_mode" value="recurring" /><span>Pagam de forma recorrente</span></label><label class="choice"><input type="radio" name="purchase_mode" value="mixed" /><span>Depende do que é vendido</span></label></div>
            </fieldset>
          </div>
          <div class="question" data-step="4" hidden>
            <fieldset><legend>Existem pessoas que demonstraram interesse e não compraram?</legend>
              <div class="choice-grid choice-grid--four"><label class="choice"><input type="radio" name="stalled_interest" value="many" required /><span>Muitas</span></label><label class="choice"><input type="radio" name="stalled_interest" value="some" /><span>Algumas</span></label><label class="choice"><input type="radio" name="stalled_interest" value="few" /><span>Poucas</span></label><label class="choice"><input type="radio" name="stalled_interest" value="unknown" /><span>Não sei</span></label></div>
            </fieldset>
          </div>
          <div class="question" data-step="5" hidden>
            <fieldset><legend>Existem clientes antigos que poderiam comprar novamente?</legend>
              <div class="choice-grid"><label class="choice"><input type="radio" name="repurchase_potential" value="many" required /><span>Sim, muitos</span></label><label class="choice"><input type="radio" name="repurchase_potential" value="some" /><span>Sim, alguns</span></label><label class="choice"><input type="radio" name="repurchase_potential" value="few" /><span>Talvez poucos</span></label><label class="choice"><input type="radio" name="repurchase_potential" value="not_applicable" /><span>Não se aplica</span></label><label class="choice"><input type="radio" name="repurchase_potential" value="unknown" /><span>Não sei</span></label></div>
            </fieldset>
          </div>
          <div class="question" data-step="6" hidden>
            <fieldset><legend>Existe agenda, estoque ou capacidade que poderia vender mais?</legend>
              <div class="choice-grid choice-grid--four"><label class="choice"><input type="radio" name="idle_capacity" value="yes" required /><span>Sim</span></label><label class="choice"><input type="radio" name="idle_capacity" value="maybe" /><span>Talvez</span></label><label class="choice"><input type="radio" name="idle_capacity" value="no" /><span>Não</span></label><label class="choice"><input type="radio" name="idle_capacity" value="unknown" /><span>Não sei</span></label></div>
            </fieldset>
          </div>
          <div class="question" data-step="7" hidden>
            <fieldset><legend>Existem clientes que poderiam comprar algo complementar ou de maior valor?</legend>
              <div class="choice-grid"><label class="choice"><input type="radio" name="complementary_sale" value="yes" required /><span>Sim</span></label><label class="choice"><input type="radio" name="complementary_sale" value="maybe" /><span>Talvez</span></label><label class="choice"><input type="radio" name="complementary_sale" value="unknown" /><span>Não sei</span></label><label class="choice"><input type="radio" name="complementary_sale" value="not_applicable" /><span>Não se aplica</span></label></div>
            </fieldset>
          </div>
          <div class="question" data-step="8" hidden>
            <fieldset><legend>Onde sua empresa mais perde oportunidades hoje?</legend>
              <div class="choice-grid"><label class="choice"><input type="radio" name="opportunity_loss" value="lead_generation" required /><span>Geração de leads</span></label><label class="choice"><input type="radio" name="opportunity_loss" value="conversion" /><span>Conversão de interessados em clientes</span></label><label class="choice"><input type="radio" name="opportunity_loss" value="reactivation" /><span>Reativação de clientes antigos</span></label><label class="choice"><input type="radio" name="opportunity_loss" value="expansion" /><span>Expansão das vendas para clientes atuais</span></label><label class="choice"><input type="radio" name="opportunity_loss" value="capacity" /><span>Uso da capacidade disponível</span></label></div>
            </fieldset>
          </div>
          <div class="question" data-step="9" hidden>
            <label for="priority_30_days">Se pudesse melhorar uma coisa nos próximos 30 dias, o que teria maior impacto?</label>
            <p class="hint">Esta é a pergunta aberta. Descreva o que está mais urgente para você.</p>
            <textarea id="priority_30_days" name="priority_30_days" rows="5" minlength="2" maxlength="1000" required></textarea>
          </div>

          <div class="form-actions"><button class="button button-secondary" id="back-button" type="button" hidden>Voltar</button><button class="button button-primary" id="next-button" type="button">Continuar <span aria-hidden="true">→</span></button></div>
          <div class="technical-field" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
        </form>
      </section>

      <section class="contact-panel" id="contact-panel" data-panel-state="contact" hidden aria-hidden="true" aria-labelledby="contact-title">
        <div class="completion-context" aria-label="Conclusão do questionário">
          <p>Você concluiu as 10 perguntas</p>
          <span>Falta apenas confirmar onde entregamos seu resultado.</span>
        </div>
        <p class="kicker">SEU RAIO-X <span aria-hidden="true">/</span> ENTREGA</p>
        <h2 id="contact-title">Onde entregamos seu resultado?</h2>
        <p class="lead">Informe seu e-mail para exibir o diagnóstico nesta página. O envio de conteúdo da Sucesso é opcional.</p>
        <form id="contact-form" novalidate>
          <label for="email">Seu melhor e-mail</label>
          <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
          <label for="whatsapp">Seu WhatsApp</label>
          <input id="whatsapp" name="whatsapp" type="tel" autocomplete="tel" inputmode="tel" maxlength="32" pattern="[+0-9() .-]{8,32}" />
          <p class="hint">Usaremos para identificar seu diagnóstico e facilitar nossa comunicação.</p>
          <label class="consent"><input id="sucesso-content" name="sucesso_content" type="checkbox" checked /><span>Quero receber conteúdos da Sucesso Empresarial por e-mail. Posso cancelar quando quiser.</span></label>
          <p class="privacy-note">O consentimento é opcional e separado do diagnóstico. Consulte nossa <a href="/privacidade/">política de privacidade</a>.</p>
          {turnstileSiteKey && <div id="turnstile-widget" class="turnstile-widget" aria-label="Verificação de segurança"></div>}
          <p class="status-message" id="contact-status" role="alert" aria-live="assertive"></p>
          <button class="button button-primary button-large" id="submit-button" type="submit">Ver meu Raio-X <span aria-hidden="true">→</span></button>
        </form>
      </section>

      <section class="loading-panel" id="loading-panel" data-panel-state="loading" hidden aria-hidden="true" aria-labelledby="loading-title">
        <div class="loader" aria-hidden="true"></div><p class="kicker">ANALISANDO RESPOSTAS</p><h2 id="loading-title">Estamos analisando seu contexto.</h2><p>Estamos cruzando suas respostas para montar três oportunidades e uma ação prática para os próximos 7 dias. A análise pode levar até 90 segundos; não feche esta página.</p>
      </section>

      <section class="result-panel" id="result-panel" data-panel-state="result" hidden aria-hidden="true" aria-labelledby="result-title"><div id="result-content"></div></section>
      <section class="error-panel" id="error-panel" data-panel-state="error" hidden aria-hidden="true" aria-labelledby="error-title" role="alert" aria-live="assertive"><p class="kicker">Raio-X interrompido</p><h2 id="error-title" tabindex="-1">Houve uma falha no processamento</h2><p id="error-copy">Suas respostas foram preservadas. Você não precisa responder novamente.</p><button class="button button-primary button-large" id="retry-button" type="button">Revisar e reenviar</button></section>
    </main>

    <footer><a href="/privacidade/">Privacidade</a><span>•</span><a href="/termos/">Termos</a><span>•</span><span>Sucesso Empresarial</span></footer>

    <!-- QA: esta página chama apenas fontes, Turnstile quando configurado e a API do diagnóstico; não solicita permissões externas. -->
    <script define:vars={{ apiBase, turnstileSiteKey }}>
      const API_BASE = apiBase;
      const TURNSTILE_SITEKEY = turnstileSiteKey;
      const ENDPOINT = `${API_BASE.replace(/\/$/, '')}/api/raio-x/diagnoses`;
      const form = document.querySelector('#diagnosis-form');
      const questions = [...document.querySelectorAll('.question')];
      const intro = document.querySelector('#intro');
      const formPanel = document.querySelector('#form-panel');
      const contactPanel = document.querySelector('#contact-panel');
      const loadingPanel = document.querySelector('#loading-panel');
      const resultPanel = document.querySelector('#result-panel');
      const errorPanel = document.querySelector('#error-panel');
      const nextButton = document.querySelector('#next-button');
      const backButton = document.querySelector('#back-button');
      const progressCurrent = document.querySelector('#progress-current');
      const progressBar = document.querySelector('#progress-bar');
      const formStatus = document.querySelector('#form-status');
      const email = document.querySelector('#email');
      const whatsapp = document.querySelector('#whatsapp');
      let step = 0;
      let lastSubmission = null;
      let isSubmitting = false;
      let turnstileToken = null;
      let turnstileWidgetId = null;
      let turnstileLoadFailed = false;

      const sourceMap = { supleno: 'supleno', resultado21: 'resultado21', instagram: 'instagram', conteudo: 'conteudo' };
      function requestId() { return `rx-${crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(16).slice(2)}`}`; }
      function getSource() { const params = new URLSearchParams(window.location.search); return sourceMap[params.get('origem')] || sourceMap[params.get('utm_source')] || 'other'; }
      function getUtm() { const params = new URLSearchParams(window.location.search); const keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term']; return Object.fromEntries(keys.map((key) => [key, params.get(key)]).filter(([, value]) => value)); }
      const panels = [intro, formPanel, contactPanel, loadingPanel, resultPanel, errorPanel];
      function showOnly(panel) {
        panels.forEach((item) => {
          const active = item === panel;
          item.hidden = !active;
          item.setAttribute('aria-hidden', String(!active));
        });
        document.querySelector('main').dataset.state = panel.dataset.panelState;
        window.scrollTo({ top: 0, behavior: 'auto' });
        const heading = panel.querySelector('h1, h2');
        if (heading) {
          heading.focus({ preventScroll: true });
          heading.scrollIntoView({ behavior: 'auto', block: 'start' });
        }
      }
      function updateStep({ focus = true } = {}) { questions.forEach((question, index) => { question.hidden = index !== step; }); progressCurrent.textContent = String(step + 1); progressBar.style.width = `${((step + 1) / questions.length) * 100}%`; backButton.hidden = step === 0; nextButton.textContent = step === questions.length - 1 ? 'Continuar para o contato →' : 'Continuar →'; const activeQuestion = questions[step]; activeQuestion.setAttribute('aria-current', 'step'); questions.forEach((question, index) => { if (index !== step) question.removeAttribute('aria-current'); }); requestAnimationFrame(() => { activeQuestion.scrollIntoView({ behavior: 'smooth', block: 'start' }); if (focus) activeQuestion.querySelector('input, textarea')?.focus({ preventScroll: true }); }); }
      function validateCurrent() { const fields = [...questions[step].querySelectorAll('input:not([type="radio"]), textarea'), ...questions[step].querySelectorAll('input[type="radio"]:checked')]; const requiredField = questions[step].querySelector('input[required], textarea[required]'); if (requiredField?.type === 'radio' && !questions[step].querySelector('input[type="radio"]:checked')) { formStatus.textContent = 'Escolha uma opção para continuar.'; return false; } if (requiredField && requiredField.type !== 'radio' && !requiredField.checkValidity()) { requiredField.reportValidity(); return false; } if (!fields.length && requiredField) { formStatus.textContent = 'Escolha uma opção para continuar.'; return false; } formStatus.textContent = ''; return true; }
      document.querySelector('#start-button').addEventListener('click', () => { step = 0; showOnly(formPanel); updateStep(); });
      function initializeTurnstile() {
        if (!TURNSTILE_SITEKEY || turnstileWidgetId !== null) return Promise.resolve();
        return new Promise((resolve, reject) => {
          const started = Date.now();
          const wait = () => {
            if (window.turnstile?.render) {
              turnstileWidgetId = window.turnstile.render('#turnstile-widget', { sitekey: TURNSTILE_SITEKEY, callback: (token) => { turnstileToken = token; }, 'expired-callback': () => { turnstileToken = null; }, 'error-callback': () => { turnstileToken = null; turnstileLoadFailed = true; document.querySelector('#contact-status').textContent = 'A verificação de segurança falhou. Tente novamente.'; } });
              resolve();
            } else if (Date.now() - started > 8000) {
              turnstileLoadFailed = true;
              reject(new Error('TURNSTILE_LOAD_FAILED'));
            } else setTimeout(wait, 50);
          };
          wait();
        });
      }
      nextButton.addEventListener('click', () => { if (!validateCurrent()) return; if (step < questions.length - 1) { step += 1; updateStep(); } else { showOnly(contactPanel); document.querySelector('#email').focus(); initializeTurnstile().catch(() => { document.querySelector('#contact-status').textContent = 'Não foi possível carregar a verificação de segurança.'; }); } });
      backButton.addEventListener('click', () => { if (step > 0) { step -= 1; updateStep(); } });
      function collectAnswers() { const data = Object.fromEntries(new FormData(form).entries()); const honeypot = data.website || ''; delete data.website; return { answers: data, honeypot }; }
      function escapeHtml(value) { return text(value).replace(/[&<>\"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', "'": '&#39;' })[character]); }
      function validResult(data) { const report = data?.report; return Boolean(data?.diagnosis_id && /^RXS-[A-Za-z0-9_-]+$/.test(data.diagnosis_id) && data.status === 'completed' && report && Array.isArray(report.opportunities) && report.opportunities.length === 3 && report.action_7_days && Array.isArray(data.continuation_options)); }
      function text(value) { return typeof value === 'string' ? value : ''; }
      const TURNSTILE_ERROR_CODES = new Set(['TURNSTILE_TOKEN_EXPIRED', 'TURNSTILE_TOKEN_INVALID', 'TURNSTILE_EXPIRED', 'TURNSTILE_REJECTED']);
      const INVALID_DATA_ERROR_CODES = new Set(['INVALID_DATA', 'VALIDATION_ERROR', 'VALIDATION_FAILED', 'INVALID_REQUEST']);
      function safeErrorValue(value, maxLength = 80) { return typeof value === 'string' && /^[A-Za-z0-9_.:-]{1,128}$/.test(value) ? value.slice(0, maxLength) : null; }
      async function parseApiError(response) {
        try {
          const payload = await response.json();
          const source = payload?.error && typeof payload.error === 'object' ? payload.error : payload;
          return { status: response.status, code: safeErrorValue(source?.code), requestId: safeErrorValue(source?.request_id || payload?.request_id, 128) };
        } catch {
          return { status: response.status, code: null, requestId: null };
        }
      }
      function errorMessage(apiError) {
        const code = apiError?.code;
        let message = 'Não foi possível concluir agora. Tente novamente em instantes.';
        if (TURNSTILE_ERROR_CODES.has(code) || code?.startsWith('TURNSTILE_')) message = 'A verificação de segurança expirou ou foi recusada. Volte, conclua a verificação e reenvie.';
        else if (apiError?.status === 422 || INVALID_DATA_ERROR_CODES.has(code)) message = 'Alguns dados precisam ser revisados. Volte, confira os campos e reenvie.';
        const details = [code ? `Código: ${code}` : '', apiError?.requestId ? `Referência: ${apiError.requestId}` : ''].filter(Boolean).join(' · ');
        return `${message}${details ? ` ${details}` : ''}`;
      }
      function renderError(error) {
        document.querySelector('#error-copy').textContent = `Suas respostas continuam salvas, incluindo os dados de contato. ${errorMessage(error?.apiError)}`;
        showOnly(errorPanel);
      }
      function renderResult(data) { const report = data.report; const recommended = Number.isInteger(report.recommended_opportunity_index) ? report.recommended_opportunity_index : 0; const opportunityCards = report.opportunities.map((item, index) => `<article class="opportunity ${index === recommended ? 'opportunity--recommended' : ''}"><p class="opportunity-number">0${index + 1}${index === recommended ? ' · RECOMENDADA' : ''}</p><h3>${escapeHtml(item.title)}</h3><p>${escapeHtml(item.reason)}</p><ul>${(item.evidence_basis || []).map((evidence) => `<li>${escapeHtml(evidence)}</li>`).join('')}</ul><p class="meta">Esforço ${escapeHtml(item.effort)} · Velocidade ${escapeHtml(item.speed)}</p></article>`).join(''); const steps = (report.action_7_days.steps || []).map((item) => `<li>${escapeHtml(item)}</li>`).join(''); const options = [{ id: 'self_serve', title: 'Quero tentar sozinho', copy: 'Levar o prompt e os próximos passos para a rotina.' }, { id: 'learn_with_ai', title: 'Quero aprender a executar com IA', copy: 'Conhecer o Resultado 21 se fizer sentido para o seu momento.' }, { id: 'implementation_help', title: 'Quero ajuda para implantar', copy: 'Conversar sobre um caminho de execução para o negócio.' }].filter((option) => data.continuation_options.includes(option.id)); document.querySelector('#result-content').innerHTML = `<p class="kicker">SEU RAIO-X <span aria-hidden="true">/</span> ${escapeHtml(data.diagnosis_id)}</p><h2 id="result-title">Seu mapa de oportunidades</h2><p class="result-summary">${escapeHtml(report.summary)}</p><div class="profile"><p class="label">PERFIL RESUMIDO</p><p>${escapeHtml(report.business_profile)}</p></div><div class="opportunity-list"><h3>Três oportunidades para olhar agora</h3>${opportunityCards}</div><div class="seven-day"><p class="label">PRÓXIMOS 7 DIAS</p><h3>${escapeHtml(report.action_7_days.objective)}</h3><ol>${steps}</ol><p><b>Métrica:</b> ${escapeHtml(report.action_7_days.metric)}</p></div><div class="prompt-box"><p class="label">PROMPT PERSONALIZADO</p><p>${escapeHtml(report.personalized_prompt)}</p></div><div class="continuation"><p class="label">ESCOLHA O PRÓXIMO PASSO</p><div class="continuation-grid">${options.map((option) => `<button class="continuation-option" type="button" data-continuation="${option.id}"><b>${option.title}</b><span>${option.copy}</span></button>`).join('')}</div><p class="choice-feedback" id="choice-feedback" role="status"></p></div><p class="limitations"><b>Limitações do diagnóstico:</b> ${(report.limitations || []).map(escapeHtml).join(' ')}</p>`; document.querySelectorAll('[data-continuation]').forEach((button) => button.addEventListener('click', () => chooseContinuation(button.dataset.continuation, data))); }
      function chooseContinuation(choice, data) { const feedback = document.querySelector('#choice-feedback'); if (choice === 'learn_with_ai') { feedback.innerHTML = 'Você pode conhecer o <a href="/resultado21/">Resultado 21</a> como uma opção de aprendizagem prática. A escolha é sua.'; return; } feedback.textContent = choice === 'self_serve' ? 'Certo. Comece pela ação de 7 dias e use o prompt como apoio.' : 'Certo. Esse interesse fica registrado para orientar o próximo contato, sem inscrição automática.'; }
      async function submitDiagnosis(event) { event.preventDefault(); if (isSubmitting) return; if (!email.checkValidity()) { email.reportValidity(); return; } if (whatsapp.value && !whatsapp.checkValidity()) { whatsapp.reportValidity(); return; } if (TURNSTILE_SITEKEY) { if (turnstileLoadFailed || !turnstileToken) { document.querySelector('#contact-status').textContent = 'Conclua a verificação de segurança antes de enviar.'; return; } } const collected = collectAnswers(); if (collected.honeypot) return; lastSubmission = { request_id: requestId(), source: getSource(), utm: getUtm(), answers: collected.answers, honeypot: collected.honeypot, ...(TURNSTILE_SITEKEY ? { turnstile_token: turnstileToken } : {}), contact: { email: email.value.trim(), whatsapp: whatsapp.value.trim() || null }, consent: { sucesso_content: document.querySelector('#sucesso-content').checked } }; isSubmitting = true; document.querySelector('#submit-button').disabled = true; showOnly(loadingPanel); const controller = new AbortController(); const timeout = setTimeout(() => controller.abort(), 90000); try { const response = await fetch(ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Idempotency-Key': lastSubmission.request_id }, body: JSON.stringify(lastSubmission), signal: controller.signal }); if (!response.ok) { const apiError = await parseApiError(response); const failure = new Error('API_REQUEST_FAILED'); failure.apiError = apiError; throw failure; } const data = await response.json(); if (!validResult(data)) throw new Error('INVALID_RESPONSE'); renderResult(data); showOnly(resultPanel); } catch (error) { renderError(error); } finally { clearTimeout(timeout); isSubmitting = false; document.querySelector('#submit-button').disabled = false; } }
      document.querySelector('#contact-form').addEventListener('submit', submitDiagnosis);
      document.querySelector('#retry-button').addEventListener('click', () => { showOnly(contactPanel); document.querySelector('#email').focus(); });
    </script>

    <style>
      :root { --ink: #eaf1f5; --muted: #a4b2bd; --navy: #071829; --panel: #0d2435; --line: #284253; --lime: #c4f36a; --orange: #ff9f5a; --focus: #8bd5ff; }
      :global([hidden]) { display: none !important; }
      * { box-sizing: border-box; }
      html { background: var(--navy); }
      body { margin: 0; color: var(--ink); background: radial-gradient(circle at 90% 0%, #173a4d 0, transparent 34rem), var(--navy); font-family: Manrope, sans-serif; line-height: 1.6; min-height: 100vh; }
      a { color: var(--lime); }
      button, input, textarea { font: inherit; }
      button, a { -webkit-tap-highlight-color: transparent; }
      :focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
      .site-header { max-width: 1180px; margin: auto; padding: 28px 28px 0; display: flex; justify-content: space-between; align-items: center; }
      .brand { color: var(--ink); text-decoration: none; display: flex; gap: 10px; align-items: center; font-size: .84rem; letter-spacing: .04em; text-transform: uppercase; }
      .brand b { color: var(--lime); font-weight: 700; }
      .brand-mark { display: block; width: 72px; height: 72px; flex: 0 0 72px; }
      .brand-mark img { display: block; width: 100%; height: 100%; object-fit: contain; }
      .header-link { font-size: .78rem; color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--line); padding-bottom: 2px; }
      .shell { width: min(100% - 40px, 780px); margin: 0 auto; padding: 36px 0 90px; }
      .intro { min-height: 62vh; display: flex; flex-direction: column; justify-content: center; }
      .kicker, .label, .progress-text, .opportunity-number { color: var(--lime); font-family: 'DM Mono', monospace; font-size: .72rem; letter-spacing: .13em; text-transform: uppercase; }
      h1, h2, h3, p { margin-top: 0; }
      h1 { max-width: 680px; margin-bottom: 26px; font-size: clamp(2rem, 3.75vw, 3.25rem); line-height: 1.04; letter-spacing: -.06em; }
      h2 { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.04; letter-spacing: -.06em; }
      h3 { line-height: 1.2; }
      .lead { max-width: 590px; color: var(--muted); font-size: clamp(1rem, 2vw, 1.16rem); }
      .trust-row { display: flex; flex-wrap: wrap; gap: 10px 24px; color: #d0dde4; font-size: .76rem; margin: 34px 0 42px; }
      .trust-row span::before { content: '•'; color: var(--orange); margin-right: 8px; }
      .button { min-height: 48px; border: 1px solid transparent; border-radius: 2px; cursor: pointer; padding: 10px 17px; font-weight: 800; transition: transform .2s, background .2s; }
      .button:disabled { cursor: wait; opacity: .65; transform: none; }
      .button:hover { transform: translateY(-2px); }
      .button-primary { color: var(--navy); background: var(--lime); }
      .button-primary:hover { background: #dbff91; }
      .button-secondary { color: var(--ink); background: transparent; border-color: var(--line); }
      .button-large { align-self: flex-start; min-height: 50px; padding-inline: 22px; }
