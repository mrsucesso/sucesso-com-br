      @keyframes spin { to { transform: rotate(360deg); } }
      @media (max-width: 600px) { .site-header { padding: 20px 20px 0; } .shell { width: min(100% - 32px, 780px); padding-top: 64px; } .intro { min-height: 70vh; } .choice-grid { grid-template-columns: 1fr; } .choice-grid--four { grid-template-columns: repeat(2, minmax(0, 1fr)); } h1 { font-size: clamp(2.5rem, 14vw, 4rem); } .progress-track { margin-bottom: 43px; } .form-actions { margin-top: 32px; } }
