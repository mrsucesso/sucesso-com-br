      .loader { width: 38px; height: 38px; border: 3px solid var(--line); border-top-color: var(--lime); border-radius: 50%; animation: spin 1s linear infinite; margin: 35px 0; }
      .result-summary { color: var(--muted); font-size: 1.1rem; max-width: 650px; }
      .profile, .seven-day, .prompt-box { padding: 24px; margin: 30px 0; background: var(--panel); border-left: 3px solid var(--orange); }
