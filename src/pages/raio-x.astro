      .continuation-option span { color: var(--muted); font-size: .84rem; }
      .choice-feedback { min-height: 2em; margin-top: 15px; color: var(--muted); }
      .limitations { color: var(--muted); font-size: .76rem; margin-top: 40px; }
      .contact-panel h2, .error-panel h2 { max-width: 620px; margin-bottom: 12px; font-size: clamp(1.8rem, 4vw, 2.65rem); }
      .contact-panel .lead { max-width: 560px; margin-bottom: 18px; font-size: clamp(.95rem, 1.8vw, 1.05rem); }
      .contact-panel .kicker, .error-panel .kicker { margin-bottom: 10px; }
      .contact-panel form > label:not(.consent) { display: block; margin-bottom: 7px; font-size: .9rem; font-weight: 700; }
      .contact-panel input[type='email'], .contact-panel input[type='tel'] { min-height: 48px; }
      .error-panel { max-width: 680px; padding-top: 24px; }
      .error-panel h2 { margin-bottom: 10px; }
      .error-panel #error-copy { max-width: 560px; color: var(--muted); margin-bottom: 0; }
      .error-panel .button { margin-top: 20px; }
      footer { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 12px; padding: 24px; border-top: 1px solid rgba(40, 66, 83, .6); color: var(--muted); font-size: .75rem; }
      footer a { color: var(--muted); }
      @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
      @keyframes spin { to { transform: rotate(360deg); } }
      @media (max-width: 600px) { .site-header { padding: 20px 20px 0; } .shell { width: min(100% - 32px, 780px); padding-top: 36px; } .intro { min-height: 70vh; } .choice-grid { grid-template-columns: 1fr; } .choice-grid--four { grid-template-columns: repeat(2, minmax(0, 1fr)); } h1 { font-size: clamp(2rem, 8vw, 2.55rem); } .progress-track { margin-bottom: 43px; } .form-actions { margin-top: 32px; } }
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
    </style>
