      .completion-context { padding: 14px 16px; margin-bottom: 20px; border: 1px solid rgba(196, 243, 106, .45); border-left: 3px solid var(--lime); background: rgba(196, 243, 106, .08); }
      .completion-context p { margin-bottom: 3px; color: var(--lime); font-size: .95rem; font-weight: 800; }
      .completion-context span { color: #d6e3e8; font-size: .86rem; }
