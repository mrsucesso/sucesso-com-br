---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const title = 'Blog | Sucesso Empresarial';
const description = 'Conteúdos práticos sobre inteligência artificial, automação e gestão para empresas em movimento.';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://sucesso.com.br/blog/" />
    <link rel="icon" type="image/png" sizes="512x512" href="/images/favicon-sucesso-empresarial.png" />
    <link rel="apple-touch-icon" href="/images/favicon-sucesso-empresarial.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sucesso.com.br/blog/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://sucesso.com.br/images/og-sucesso-empresarial.jpg" />
    <style>
      :root { --navy-950:#061522; --navy-900:#0a1d2d; --green:#19c77a; --gold:#e5b75d; --ink:#132334; --muted:#5a6978; --paper:#f4f7f8; --line:#dbe4e9; --white:#fff; }
      * { box-sizing:border-box; }
      body { margin:0; color:var(--ink); background:var(--paper); font-family:Inter,system-ui,sans-serif; line-height:1.65; }
      a { color:inherit; }
      .container { width:min(1140px,calc(100% - 2.5rem)); margin:0 auto; }
      .topbar { padding:1.25rem 0; color:var(--white); background:var(--navy-950); }
      .topbar__inner { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
      .brand { display:inline-flex; align-items:center; width:72px; height:72px; padding:.15rem; border-radius:50%; background:var(--white); box-shadow:0 8px 22px rgba(0,0,0,.16); text-decoration:none; }
      .brand img { width:100%; height:100%; border-radius:50%; object-fit:cover; }
      nav { display:flex; align-items:center; gap:1.3rem; font-size:.88rem; font-weight:700; }
      nav a { color:#dbe7ee; text-decoration:none; }
      nav a:hover { color:var(--white); }
      .hero { padding:6.5rem 0 5rem; color:var(--white); background:linear-gradient(115deg,var(--navy-950),var(--navy-900) 68%,#12344f); }
      .eyebrow { display:inline-flex; align-items:center; gap:.55rem; margin:0 0 1.2rem; color:var(--green); font-size:.76rem; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
      .eyebrow::before { content:''; width:1.8rem; height:2px; background:currentColor; }
      h1,h2,h3 { margin-top:0; font-family:Manrope,Inter,sans-serif; line-height:1.1; letter-spacing:-.035em; }
      h1 { max-width:12ch; margin-bottom:1.2rem; font-size:clamp(2.8rem,6vw,5.2rem); }
      .hero p { max-width:680px; margin:0; color:#c8d5df; font-size:1.15rem; }
      main { padding:5.5rem 0 7rem; }
      .section-head { display:flex; align-items:end; justify-content:space-between; gap:2rem; margin-bottom:2.5rem; }
      .section-head h2 { max-width:14ch; margin-bottom:0; font-size:clamp(2rem,4vw,3.2rem); }
      .section-head p { max-width:480px; margin:0; color:var(--muted); }
      .posts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
      .post { display:flex; flex-direction:column; min-height:330px; padding:2rem; border:1px solid var(--line); border-radius:1rem; background:var(--white); transition:transform .2s ease,box-shadow .2s ease; }
      .post:hover { transform:translateY(-3px); box-shadow:0 18px 42px rgba(6,21,34,.1); }
      .post__meta { display:flex; justify-content:space-between; gap:1rem; margin-bottom:3rem; color:#748392; font-size:.8rem; }
      .post__tag { color:#0d9d5d; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
      .post h2 { margin-bottom:.8rem; font-size:1.55rem; }
      .post h2 a { text-decoration:none; }
      .post h2 a:hover { color:#0d9d5d; }
      .post p { margin-bottom:1.4rem; color:var(--muted); }
      .post__link { margin-top:auto; color:#0d9d5d; font-weight:800; text-decoration:none; }
      .post__link::after { content:'  ↗'; }
      .cta { margin-top:5rem; padding:3rem; border-radius:1.1rem; color:var(--white); background:var(--navy-900); }
      .cta h2 { max-width:15ch; margin-bottom:.8rem; font-size:clamp(1.8rem,4vw,2.8rem); }
      .cta p { max-width:620px; margin-bottom:1.4rem; color:#c4d2dd; }
      .button { display:inline-flex; min-height:3.3rem; align-items:center; justify-content:center; padding:.9rem 1.3rem; border-radius:.7rem; color:#052015; background:var(--green); font-weight:800; text-decoration:none; }
      footer { padding:2.8rem 0; color:#b8c8d4; background:var(--navy-950); }
      footer .footer__inner { display:flex; justify-content:space-between; gap:2rem; }
      footer strong { color:var(--white); font-family:Manrope,sans-serif; }
      footer a { color:var(--green); text-decoration:none; }
      @media (max-width:760px) { nav a:not(:last-child) { display:none; } .section-head, footer .footer__inner { align-items:start; flex-direction:column; } .posts { grid-template-columns:1fr; } .post { min-height:280px; } }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="container topbar__inner">
        <a class="brand" href="/" aria-label="Sucesso Empresarial"><img src="/images/logo-sucesso-empresarial-1997.jpg" alt="Sucesso Empresarial 1997" /></a>
        <nav aria-label="Navegação principal"><a href="/">Início</a><a href="/resultado21/">Resultado 21</a><a href="/blog/">Conteúdos</a><a href="mailto:mauricio@sucesso.com.br">Contato</a></nav>
      </div>
    </header>
    <section class="hero"><div class="container"><p class="eyebrow">Conteúdo Sucesso Empresarial</p><h1>Ideias para empresas em movimento.</h1><p>Inteligência artificial, automação e gestão explicadas sem fumaça. Conteúdo para quem quer entender o problema e fazer o próximo movimento.</p></div></section>
    <main class="container">
      <div class="section-head"><div><p class="eyebrow">Artigos</p><h2>O que merece sua atenção agora.</h2></div><p>Leituras práticas para conectar tecnologia à operação real da empresa.</p></div>
      <section class="posts" aria-label="Artigos do blog">
        {posts.map((post) => (
          <article class="post">
            <div class="post__meta"><span class="post__tag">{post.data.tags[0] ?? 'Gestão'}</span><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('pt-BR', { day:'2-digit', month:'short', year:'numeric' })}</time></div>
            <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <a class="post__link" href={`/blog/${post.id}/`}>Ler artigo</a>
          </article>
        ))}
      </section>
      <section class="cta"><p class="eyebrow">Da leitura à execução</p><h2>Tem um problema concreto para resolver?</h2><p>A Sucesso Empresarial ajuda a transformar oportunidade, processo e tecnologia em um próximo movimento claro.</p><a class="button" href="mailto:mauricio@sucesso.com.br">Fale com a Sucesso</a></section>
    </main>
    <footer><div class="container footer__inner"><div><p><strong>Sucesso Empresarial Ltda</strong></p><p>CNPJ: 01.655.728/0001-14</p><p><a href="mailto:mauricio@sucesso.com.br">mauricio@sucesso.com.br</a></p></div><div><a href="/privacidade/">Privacidade</a> · <a href="/termos/">Termos</a></div></div></footer>
  </body>
</html>
