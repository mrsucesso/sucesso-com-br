---
const PIXEL_ID = '28536331392735087';
---
<script define:vars={{ PIXEL_ID }}>
  (() => {
    if (!['sucesso.com.br', 'www.sucesso.com.br'].includes(window.location.hostname)) return;
    const storageKey = 'sucesso-meta-consent-v1';
    let consent = null;
    try { consent = localStorage.getItem(storageKey); } catch (_) {}
    function startPixel() {
      if (window.__sucessoMetaPixelStarted) return;
      window.__sucessoMetaPixelStarted = true;
      if (!window.fbq) {
        const fbq = function () {
          if (fbq.callMethod) fbq.callMethod.apply(fbq, arguments);
          else fbq.queue.push(arguments);
        };
        fbq.push = fbq;
        fbq.loaded = true;
        fbq.version = '2.0';
        fbq.queue = [];
        window.fbq = fbq;
        window._fbq = fbq;
      }
      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://connect.facebook.net/en_US/fbevents.js';
      document.head.appendChild(script);
      window.fbq('consent', 'grant');
      window.fbq('set', 'autoConfig', false, PIXEL_ID);
      window.fbq('init', PIXEL_ID);
      window.fbq('track', 'PageView');
    }
    const recordedLeads = new Set();
    window.sucessoTrackLead = function (submissionId) {
      if (consent !== 'yes' || !window.__sucessoMetaPixelStarted ||
          typeof submissionId !== 'string' || !submissionId ||
          recordedLeads.has(submissionId)) return;
      recordedLeads.add(submissionId);
      window.fbq('track', 'Lead');
    };
    function render() {
      if (consent || !document.body) return;
      const banner = document.createElement('section');
      banner.className = 'sucesso-meta-consent';
      banner.setAttribute('aria-label', 'Preferências de medição');
      banner.innerHTML = '<p><b>Podemos medir visitas para melhorar o site?</b><span>Você pode mudar isso depois.</span></p><div><button type="button" data-choice="yes">Permitir</button><button type="button" data-choice="no">Agora não</button></div>';
      banner.addEventListener('click', (event) => {
        const button = event.target.closest('button[data-choice]');
        if (!button) return;
        consent = button.dataset.choice;
        try { localStorage.setItem(storageKey, consent); } catch (_) {}
        if (consent === 'yes') startPixel();
        banner.remove();
      });
      document.body.appendChild(banner);
    }
    if (consent === 'yes') startPixel();
    else if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', render, { once: true });
    else render();
  })();
</script>
<style>
  :global(.sucesso-meta-consent) { position:fixed; right:1rem; bottom:1rem; z-index:9999; width:min(21rem,calc(100% - 2rem)); padding:.72rem .8rem; background:rgba(255,255,255,.97); color:#15233a; border:1px solid #d8dfeb; border-radius:.6rem; box-shadow:0 6px 18px rgba(0,0,0,.13); font:12px/1.4 system-ui,sans-serif; }
  :global(.sucesso-meta-consent p) { margin:0 0 .55rem; }
  :global(.sucesso-meta-consent p b) { display:block; font-size:.78rem; font-weight:650; }
  :global(.sucesso-meta-consent p span) { display:block; margin-top:.12rem; color:#5d6879; font-size:.72rem; }
  :global(.sucesso-meta-consent button) { margin:0 .35rem 0 0; padding:.38rem .6rem; border:1px solid #1b4f8a; border-radius:.35rem; background:#1b4f8a; color:#fff; cursor:pointer; font:600 .72rem/1.2 system-ui,sans-serif; }
  :global(.sucesso-meta-consent button[data-choice="no"]) { background:#fff; color:#1b4f8a; }
</style>
